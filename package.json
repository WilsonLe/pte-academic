{
  "name": "pte-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178",
    "validate:content": "tsx scripts/validate-content.ts",
    "build": "npm run validate:content && npm run validate:comparison && vite build && tsc -b && node scripts/publish-static.mjs && node scripts/build-sw.mjs && node --test tests/static-output.test.mjs",
    "preview": "vite preview --config vite.static.config.ts --outDir dist --host 127.0.0.1 --port 4178",
    "test:content": "tsx --test tests/content.test.ts tests/review.test.ts",
    "test:browser": "playwright test",
    "openrouter": "node scripts/openrouter.mjs",
    "build:subpath": "npm run validate:content && npm run validate:comparison && BASE_PATH=/pte-academic/ vite build && tsc -b && node scripts/publish-static.mjs dist-subpath && node scripts/build-sw.mjs dist-subpath && PTE_STATIC_DIR=dist-subpath node --test tests/static-output.test.mjs",
    "preview:subpath": "BASE_PATH=/pte-academic/ vite preview --config vite.static.config.ts --outDir dist-subpath --host 127.0.0.1 --port 4180",
    "test:subpath": "PTE_TEST_SUBPATH=1 playwright test tests/subpath.spec.ts",
    "test:speech": "tsx --test tests/speech-storage.test.ts",
    "test:progress": "tsx --test tests/progress.test.ts tests/progress-storage.test.ts",
    "test:local-state": "tsx --test tests/local-queries.test.ts",
    "test:comparison": "tsx --test tests/comparison.test.ts tests/comparison-storage.test.ts tests/syllable-display.test.ts tests/recognition.test.ts",
    "test:comparison:browser": "PTE_TEST_COMPARISON=1 playwright test tests/comparison.spec.ts",
    "validate:comparison": "node --test tests/comparison-assets.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
